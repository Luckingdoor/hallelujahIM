#!/bin/bash

login_user=`/usr/bin/stat -f%Su /dev/console`
login_uid=`/usr/bin/id -u "${login_user}"`
USER_HOME=$(eval echo ~${login_user})

# stop any running instance
pkill -9 hallelujah 2>/dev/null || true
sleep 1
pkill -9 hallelujah 2>/dev/null || true

# remove stale per-user copy
rm -rf "${USER_HOME}/Library/Input Methods/hallelujah.app/" 2>/dev/null || true

# copy sqlite databases to writable user directory
DB_DIR="${USER_HOME}/Library/Application Support/hallelujah"
WORDS_DB="${DB_DIR}/words_with_frequency_and_translation_and_ipa.sqlite3"
mkdir -p "${DB_DIR}"

# The bundled word list overwrites the user's copy, which would wipe any domain
# dictionaries imported through the preferences page. Dump those rows first and
# replay them afterwards, so a package upgrade ships a new base dictionary while
# keeping the user's own additions. domain_words is the ledger written by the
# import feature; if it isn't there yet, there is nothing to preserve.
DOMAIN_DUMP=""
if [ -f "${WORDS_DB}" ] && \
   [ -n "$(/usr/bin/sqlite3 "${WORDS_DB}" "SELECT name FROM sqlite_master WHERE type='table' AND name='domain_words';" 2>/dev/null)" ]; then
    DOMAIN_DUMP=$(/usr/bin/mktemp /tmp/hallelujah-domain-XXXXXX.sql)
    /usr/bin/sqlite3 "${WORDS_DB}" <<'SQL' > "${DOMAIN_DUMP}" 2>/dev/null
.mode list
.headers off
SELECT 'CREATE TABLE IF NOT EXISTS domain_words (word TEXT PRIMARY KEY, source TEXT, frequency INT);';
SELECT 'INSERT OR IGNORE INTO words (word,frequency,translation,ipa) VALUES ('
       || quote(w.word) || ',' || COALESCE(w.frequency,0) || ','
       || quote(COALESCE(w.translation,'')) || ',' || quote(COALESCE(w.ipa,'')) || ');'
  FROM words w JOIN domain_words d ON w.word = d.word;
SELECT 'INSERT OR REPLACE INTO domain_words (word,source,frequency) VALUES ('
       || quote(word) || ',' || quote(COALESCE(source,'')) || ',' || COALESCE(frequency,0) || ');'
  FROM domain_words;
SQL
fi

cp "/Library/Input Methods/hallelujah.app/Contents/Resources/words_with_frequency_and_translation_and_ipa.sqlite3" "${DB_DIR}/"
cp "/Library/Input Methods/hallelujah.app/Contents/Resources/pinyin_data.sqlite3" "${DB_DIR}/"

# replay the preserved domain words onto the freshly copied dictionary
if [ -n "${DOMAIN_DUMP}" ] && [ -s "${DOMAIN_DUMP}" ]; then
    /usr/bin/sqlite3 "${WORDS_DB}" < "${DOMAIN_DUMP}" 2>/dev/null || true
    echo "restored $(/usr/bin/sqlite3 "${WORDS_DB}" 'SELECT COUNT(*) FROM domain_words;' 2>/dev/null) imported domain words" \
        > /tmp/hallelujah-domain-restore.log
fi
rm -f "${DOMAIN_DUMP}" 2>/dev/null || true

chown -R "${login_user}" "${DB_DIR}"

# refresh the user's prefs cache BEFORE touching TIS so HIToolbox sees a
# clean state and any stale source entries can be re-evaluated.
launchctl asuser "${login_uid}" sudo -u "${login_user}" killall -HUP cfprefsd 2>/dev/null || true

# NOTE: deliberately no --deactivate here. Once the bundle declares input modes,
# TISDisableInputSource drops it from AppleEnabledInputSources and the
# TISEnableInputSource call below cannot put it back -- the API reports success
# but the list never gains the entry, so the IME silently disappears from the
# input menu and has to be re-added by hand in System Settings.

# register + enable + select inside the user's Aqua launchd session
# (plain `sudo -u` runs outside the user's GUI session and TIS changes don't
# persist correctly there, which leaves the IME in a half-registered state)
launchctl asuser "${login_uid}" sudo -u "${login_user}" \
    "/Library/Input Methods/hallelujah.app/Contents/MacOS/hallelujah" --install

# refresh again so System Settings reflects the new enabled/selected state
launchctl asuser "${login_uid}" sudo -u "${login_user}" killall -HUP cfprefsd 2>/dev/null || true

echo "hallelujah input method registered and activated successfully" > /tmp/hallelujah-postinstall
